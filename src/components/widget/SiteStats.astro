---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../../utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除 Markdown 空白字符后计算字数
		const text = post.body
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文单词
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishWords = text.match(/[a-zA-Z]+/g) || [];

		totalWords += chineseChars.length + englishWords.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 获取最新文章日期（忽略置顶状态，只按发布日期排序）
const latestPost = posts.reduce((latest, post) => {
	if (!latest) return post;
	return post.data.published > latest.data.published ? post : latest;
}, posts[0]);

const lastPostDate = latestPost
	? latestPost.data.published.toISOString()
	: null;

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "material-symbols:ecg-heart-outline",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-[var(--primary)] text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span 
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="text-sm text-neutral-500 dark:text-neutral-400 ml-1">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
  
  <!-- 分隔线 -->
  <div class="my-3 border-t border-neutral-200 dark:border-neutral-700"></div>
  
  <!-- 天气信息 -->
  <div class="flex flex-col gap-3 p-2">
    <!-- IP 定位信息 -->
    <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400">
      <Icon name="material-symbols:location-on-outline" class="text-[var(--primary)] text-lg" />
      <span id="ip-location">正在获取位置...</span>
    </div>
    
    <!-- 天气信息 -->
    <div id="weather-info" class="hidden">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div id="weather-icon" class="text-[var(--primary)] text-3xl"></div>
          <div>
            <div id="weather-temp" class="text-lg font-bold text-neutral-900 dark:text-neutral-100"></div>
            <div id="weather-desc" class="text-xs text-neutral-600 dark:text-neutral-400"></div>
          </div>
        </div>
        <div class="text-right">
          <div id="weather-humidity" class="text-xs text-neutral-500 dark:text-neutral-500"></div>
          <div id="weather-wind" class="text-xs text-neutral-500 dark:text-neutral-500"></div>
        </div>
      </div>
    </div>
    
    <!-- 省份特色文字 -->
    <div id="province-message" class="hidden p-2 bg-[var(--primary)]/5 rounded-lg border border-[var(--primary)]/10">
      <p class="text-xs text-neutral-700 dark:text-neutral-300 italic"></p>
    </div>
    
    <!-- 错误信息 -->
    <div id="weather-error" class="hidden text-xs text-neutral-500 dark:text-neutral-500 text-center py-1">
      暂时无法获取天气信息
    </div>
  </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastPostDate }}>
  function updateDynamicStats() {
    const today = new Date();
    
    // 更新运行天数
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    const runningDaysElement = document.querySelector('[data-stat-id="running-days"]');
    if (runningDaysElement) {
      runningDaysElement.textContent = diffDays.toString();
    }
    
    // 更新最后活动时间
    if (lastPostDate) {
      const lastPost = new Date(lastPostDate);
      const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
      const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));
      
      const lastUpdateElement = document.querySelector('[data-stat-id="last-update"]');
      if (lastUpdateElement) {
        lastUpdateElement.textContent = daysSinceLastUpdate.toString();
      }
    }
  }
  
  // 页面加载时更新
  updateDynamicStats();
  
  // 每小时更新一次（可选，因为天数变化较慢）
  setInterval(updateDynamicStats, 60 * 60 * 1000);
  
  // 省份特色文案
  const provinceMessages = {
    "北京": "北京的烤鸭和炸酱面一定要尝尝，故宫的秋景更是美不胜收！",
    "天津": "天津的狗不理包子和耳朵眼炸糕很有名，听听相声更惬意～",
    "上海": "上海的豫园和小笼包不可错过，外滩夜景更是迷人！",
    "重庆": "重庆火锅麻辣鲜香，洪崖洞的夜景让人流连忘返！",
    "四川": "四川的麻婆豆腐和水煮鱼太赞了，别忘了看看大熊猫！",
    "广东": "广东的早茶和烧鹅一定要试试，饮茶文化很有韵味～",
    "江苏": "苏州园林甲天下，南京的盐水鸭也很出名哦！",
    "浙江": "杭州西湖美景如画，龙井茶香飘万里～",
    "湖南": "湖南的臭豆腐和剁椒鱼头超好吃，辣得过瘾！",
    "湖北": "武汉热干面香气扑鼻，黄鹤楼值得一游！",
    "河南": "河南烩面和胡辣汤是必尝美食，少林寺更是闻名遐迩！",
    "山东": "山东的煎饼卷大葱和青岛啤酒不能错过，泰山日出壮观！",
    "河北": "承德的避暑山庄很凉爽，驴肉火烧也很有名～",
    "山西": "山西的老陈醋和刀削面很有特色，平遥古城值得逛逛！",
    "陕西": "西安的肉夹馍和兵马俑世界闻名，古城墙骑行很惬意！",
    "甘肃": "兰州牛肉面正宗美味，敦煌莫高窟艺术瑰宝！",
    "青海": "青海的牛肉干和酸奶好好吃，一定要去试试！青海湖的美景更是令人心醉～",
    "云南": "云南的过桥米线和普洱茶很有名，大理丽江风景如画！",
    "贵州": "贵州的酸汤鱼和茅台酒很有特色，黄果树瀑布壮观！",
    "广西": "桂林山水甲天下，柳州螺蛳粉让人回味无穷！",
    "海南": "海南的清补凉和椰子鸡很清爽，三亚海滩美翻天！",
    "福建": "福建的沙县小吃和佛跳墙很有名，武夷山大红袍茶香四溢！",
    "安徽": "安徽的臭鳜鱼和毛豆腐很有特色，黄山云海令人震撼！",
    "江西": "江西的瓦罐汤和拌粉很美味，庐山风光秀美！",
    "辽宁": "东北的锅包肉和小鸡炖蘑菇很好吃，大连海鲜新鲜！",
    "吉林": "吉林的冷面和朝鲜族泡菜很有特色，长白山天池美丽！",
    "黑龙江": "哈尔滨红肠和俄式大餐很有风味，冰雪大世界壮观！",
    "内蒙古": "内蒙古的手把肉和奶茶很有草原风情，呼伦贝尔大草原辽阔！",
    "宁夏": "宁夏的手抓羊肉和枸杞很有名，沙坡头景色独特！",
    "新疆": "新疆的烤羊肉串和哈密瓜超好吃，天山天池美如画！",
    "西藏": "西藏的酥油茶和青稞酒很有特色，布达拉宫神圣庄严！",
    "香港": "香港的港式点心和丝袜奶茶很地道，维多利亚港夜景迷人！",
    "澳门": "澳门的葡式蛋挞和猪扒包很有特色，大三巴牌坊值得一看！",
    "台湾": "台湾的珍珠奶茶和蚵仔煎很有名，阿里山日月潭风景秀丽！",
  };

  // 天气图标映射
  const weatherIcons = {
    "晴": "material-symbols:sunny",
    "多云": "material-symbols:partly-cloudy-day",
    "阴": "material-symbols:cloud",
    "小雨": "material-symbols:rainy-light",
    "中雨": "material-symbols:rainy",
    "大雨": "material-symbols:rainy-heavy",
    "雷阵雨": "material-symbols:thunderstorm",
    "雪": "material-symbols:snowing",
    "雾": "material-symbols:foggy",
    "霾": "material-symbols:haze",
  };

  async function fetchWeatherAndLocation() {
    try {
      // 第一步：通过高德 API 获取 IP 定位信息
      const locationResponse = await fetch('https://restapi.amap.com/v3/ip?key=9aa187f1492687837e74648455f65179');
      if (!locationResponse.ok) {
        throw new Error('获取位置失败');
      }
      const locationData = await locationResponse.json();
      
      if (locationData.status !== '1') {
        throw new Error(locationData.info || '获取位置失败');
      }

      const province = locationData.province;
      const city = locationData.city || province;
      const adcode = locationData.adcode;

      // 更新位置显示
      const locationElement = document.getElementById('ip-location');
      if (locationElement) {
        locationElement.textContent = `📍 ${city}`;
      }

      // 第二步：使用高德天气 API 获取天气信息
      const weatherResponse = await fetch(`https://restapi.amap.com/v3/weather/weatherInfo?key=9aa187f1492687837e74648455f65179&city=${adcode}&extensions=base`);
      if (!weatherResponse.ok) {
        throw new Error('获取天气失败');
      }
      const weatherData = await weatherResponse.json();
      
      if (weatherData.status !== '1' || !weatherData.lives || weatherData.lives.length === 0) {
        throw new Error('获取天气失败');
      }

      const weather = weatherData.lives[0];
      
      // 更新天气显示
      const weatherInfo = document.getElementById('weather-info');
      const weatherIcon = document.getElementById('weather-icon');
      const weatherTemp = document.getElementById('weather-temp');
      const weatherDesc = document.getElementById('weather-desc');
      const weatherHumidity = document.getElementById('weather-humidity');
      const weatherWind = document.getElementById('weather-wind');

      if (weatherInfo) weatherInfo.classList.remove('hidden');
      
      if (weatherIcon) {
        const icon = weatherIcons[weather.weather] || "material-symbols:help";
        weatherIcon.innerHTML = `<i class="iconify" data-icon="${icon}"></i>`;
        // 重新加载图标
        if (window.Iconify) {
          window.Iconify.scanDOM();
        }
      }
      
      if (weatherTemp) {
        weatherTemp.textContent = `${weather.temperature}°C`;
      }
      
      if (weatherDesc) {
        weatherDesc.textContent = weather.weather;
      }
      
      if (weatherHumidity) {
        weatherHumidity.textContent = `湿度：${weather.humidity}%`;
      }
      
      if (weatherWind) {
        weatherWind.textContent = `风向：${weather.winddirection}风 ${weather.windpower}级`;
      }

      // 更新省份特色文案
      const messageElement = document.getElementById('province-message');
      const messageText = messageElement?.querySelector('p');
      if (messageElement && messageText) {
        const message = provinceMessages[province.replace(/省 | 市|自治区|特别行政区/g, '')];
        if (message) {
          messageText.textContent = message;
          messageElement.classList.remove('hidden');
        }
      }

    } catch (error) {
      console.error('获取天气信息失败:', error);
      const errorElement = document.getElementById('weather-error');
      const locationElement = document.getElementById('ip-location');
      
      if (locationElement) {
        locationElement.textContent = '位置获取失败';
      }
      
      if (errorElement) {
        errorElement.classList.remove('hidden');
      }
    }
  }

  // 页面加载时获取天气
  document.addEventListener('DOMContentLoaded', fetchWeatherAndLocation);
  fetchWeatherAndLocation();
</script>
